# What the setup container writes to .env beside compose.yaml.
HTTP_PORT=4533
LAN_IP=192.168.1.10
TZ=Europe/London
APP_URL=http://192.168.1.10:4533     # what phones and the web player connect to
SSL_PROXY=0
ND_IMAGE=deluan/navidrome:latest
MUSIC_DIR="/volume1/music"           # a folder on the NAS, mounted read-only
MUSIC_SRC="/volume1/music"           # what is mounted: MUSIC_DIR, or ./no-music-yet while that folder is missing
ADMIN_USER=you                       # your account (its password is never stored; it's shown once)
DSM_USER=dsm                         # the package's own administrator, for the window (its password below)
DSM_PASS=…
SCAN_EVERY=1h                        # how often Navidrome looks for new music (it also notices changes as they happen)
SHARING=false                        # share links to albums and playlists
TLS=off                              # dsm | self | off — HTTPS served by Navidrome itself
TLS_SOURCE=off
TLS_CERT=
TLS_KEY=
